# ============================================================
# Bharat Kirana — Environment Configuration TEMPLATE
# ============================================================
# 1. Copy this file to `.env` in the same folder.
# 2. Replace every placeholder below with a real value.
# 3. NEVER commit the real .env to git (already in .gitignore).
# ============================================================

# --- Supabase (Project Settings → API) ---
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_ANON_KEY=your_publishable_anon_key_here

# --- Role bootstrap ---
# Bridge used until Round 2 wires server-side role fetch from user_profiles.
# These are injected into BuildConfig (decompilable) — the REAL security boundary
# is Supabase Row-Level Security. See SETUP_STEPS.md §A for the tight RLS policies.
SUPER_ADMIN_EMAIL=your_super_admin@example.com
ADMIN_EMAILS=admin1@example.com,admin2@example.com

# --- Support / contact ---
SUPPORT_EMAIL=support@example.com

# --- Optional: Gemini AI API Key ---
# GEMINI_API_KEY=your_gemini_api_key

# --- Optional: Mappls Maps SDK (embedded store map + directions) ---
# Free tier — sign up at https://about.mappls.com/api/ then grab keys from
# https://auth.mappls.com/console/. Until these are set to real values the
# Store Information screen falls back to the static "open in Maps" card.
MAPPLS_API_KEY=your_mappls_api_key
MAPPLS_REST_KEY=your_mappls_rest_key
MAPPLS_ATLAS_CLIENT_ID=your_mappls_atlas_client_id
MAPPLS_ATLAS_CLIENT_SECRET=your_mappls_atlas_client_secret

# --- Razorpay (vendor subscription payments) ---
# Only the PUBLIC key id is needed by the app; the Checkout SDK receives it from
# our create-razorpay-order Edge Function at runtime, so this is a fallback only.
# The KEY SECRET must NEVER live here — it belongs in Supabase Edge Function
# secrets (RAZORPAY_KEY_SECRET), where signature verification happens.
RAZORPAY_KEY_ID=rzp_test_your_key_id


